# ═══════════════════════════════════════════════
# STEP 1: Choose your LLM Provider
# Select only ONE by leaving it uncommented
# ═══════════════════════════════════════════════

LLM_PROVIDER=groq          # RECOMMENDED — Free, fast, no credit card needed
# LLM_PROVIDER=gemini      # Free tier available
# LLM_PROVIDER=openai      # Paid (needs credits)
# LLM_PROVIDER=anthropic   # Paid (needs credits)
# LLM_PROVIDER=ollama      # Fully free, runs on your PC (needs Ollama installed)


# ═══════════════════════════════════════════════
# STEP 2: Choose your Embedding Provider
# ═══════════════════════════════════════════════

EMBEDDING_PROVIDER=huggingface   # RECOMMENDED — 100% Free, no key needed
# EMBEDDING_PROVIDER=gemini      # Free tier available
# EMBEDDING_PROVIDER=openai      # Paid


# ═══════════════════════════════════════════════
# STEP 3: Add the API key for your chosen provider
# Only fill the one you are using in your actual .env file
# ═══════════════════════════════════════════════

# Groq (Free) → get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# Gemini (Free tier) → get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI → get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude → get key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Settings (No key needed, just local setup)
# OLLAMA_MODEL=llama3